# API-Football (api-sports.io) Authentication Tokens
# Si tienes una suscripción compartida en varias claves (A, B, C, D, E), pon cada una:
TOKEN_A=tu_token_aqui
TOKEN_B=tu_token_aqui
TOKEN_C=tu_token_aqui
TOKEN_D=tu_token_aqui
TOKEN_E=tu_token_aqui

# Si solo tienes 1 token para toda tu suscripción de 7500 llamadas:
# TOKEN_A=tu_unico_token
# TOKEN_B=tu_unico_token
# TOKEN_C=tu_unico_token
# TOKEN_D=tu_unico_token
# TOKEN_E=tu_unico_token

# Puerto del servidor (en Render se sobreescribe automáticamente con $PORT)
PORT=8000
HOST=0.0.0.0

# Límite de seguridad diario de llamadas (tope suscrito: 7500)
DAILY_REQUEST_LIMIT=7500
CIRCUIT_BREAKER_MARGIN=50
